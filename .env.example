# ============================================================================
#  Local development runs entirely on Docker: `docker compose up -d`
#  Copy this file to `.env` — every value below already matches docker-compose.
#  Payment (mono) and Nova Post keys stay empty until the merchant accounts exist.
# ============================================================================

# --- Core -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# --- Database (docker: hart-postgres) ---------------------------------------
DATABASE_URL=postgresql://hart:hart@127.0.0.1:5445/hart

# --- Object storage (docker: hart-storage / MinIO, S3-compatible like R2) ----
S3_ENDPOINT=http://127.0.0.1:9030
S3_REGION=auto
S3_ACCESS_KEY_ID=hart
S3_SECRET_ACCESS_KEY=hartsecret
S3_BUCKET=hart-media
S3_FORCE_PATH_STYLE=true
# Public base URL for stored objects. MinIO locally, R2 custom domain in prod.
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:9030/hart-media

# --- Email (docker: hart-mail / Mailpit; prod: smtp.resend.com) -------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1050
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
ORDER_EMAIL_FROM=orders@hart-shop.test
ENQUIRY_EMAIL_TO=
ORDER_EMAIL_BCC=


# --- Payments (Plata by mono) ----------------------------------------------
# merchant token from the Plata by mono dashboard
MONO_TOKEN=PLACEHOLDER_UNTIL_MONO_MERCHANT

# --- Admin ------------------------------------------------------------------
# openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Analytics (optional; trackers stay off until consent is given) --------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_API_SECRET=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
# Admin earnings page: Google Ads spend read from GA4 by a service account.
# The whole downloaded JSON key on one variable; the property id is digits.
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=

# --- Search visibility -------------------------------------------------------
# false on staging and before launch; true only when the imprint is real.
SITE_INDEXABLE=false
